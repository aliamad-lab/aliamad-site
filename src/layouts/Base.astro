---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ui, urlFor, locales, type Locale, type PageId } from '../i18n/config';

// Polices auto-hébergées : aucune requête vers Google Fonts, donc aucun
// traceur tiers ni bandeau de consentement, comme pour les vidéos.
//
// Seuls les jeux de caractères utiles sont embarqués. Le grec n'est pas un
// ornement : l'origine du nom CALYPSO s'écrit Καλυψώ sur la page Recherche.
// Les jeux cyrilliques et vietnamiens, inutiles ici, sont écartés.
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-500.css';
import '@fontsource/eb-garamond/latin-600.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-ext-400.css';
import '@fontsource/eb-garamond/latin-ext-600.css';
import '@fontsource/eb-garamond/greek-400.css';

import '../styles/global.css';

interface Props {
  locale: Locale;
  /**
   * Absent pour les pages isolées, hors menu et sans équivalent dans l'autre
   * langue — la politique de confidentialité de DicoSemioPsy, par exemple.
   */
  pageId?: PageId;
  title: string;
  description: string;
  /**
   * Retire la page des moteurs de recherche tout en la laissant joignable.
   * Utile pour une adresse qui doit exister sans faire partie du site aux yeux
   * du public.
   */
  noindex?: boolean;
}

const { locale, pageId, title, description, noindex = false } = Astro.props;
const t = ui[locale];

const canonical = pageId ? new URL(urlFor(pageId, locale), Astro.site) : new URL(Astro.url.pathname, Astro.site);

// Le site Google Sites déclarait lang="en" sur des pages françaises. On rétablit
// ici la langue réelle de chaque page, pour les lecteurs d'écran comme pour le
// référencement. Les commentaires restent dans le frontmatter : un commentaire
// HTML serait servi au visiteur.

// Le site de recette ne doit surtout pas être indexé : il ferait doublon avec
// aliamad.com et se mettrait en concurrence avec lui dans les résultats de
// recherche. Seul le domaine définitif est indexable.
const indexable = Astro.site?.host === 'www.aliamad.com' && !noindex;

// Les fichiers de public/ doivent eux aussi porter le préfixe de déploiement,
// sans quoi les icônes manquent sur l'adresse de recette.
const asset = (file: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${file}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    {/* La gravure du chat au dos arqué, déjà utilisée comme icône du site actuel. */}
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="96x96" href={asset('favicon-96.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    {
      pageId && (
        <>
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(urlFor(pageId, l), Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(urlFor(pageId, 'fr'), Astro.site)} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
  </head>

  <body>
    <a class="skip-link" href="#contenu">{t.skipToContent}</a>
    <SiteHeader locale={locale} pageId={pageId} />
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
