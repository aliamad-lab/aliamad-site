---
import { navOrder, routes, ui, urlFor, type Locale, type PageId } from '../i18n/config';

interface Props {
  locale: Locale;
  /** Absent sur les pages isolées, sans équivalent dans l'autre langue. */
  pageId?: PageId;
}

const { locale, pageId } = Astro.props;
const t = ui[locale];

// Le sélecteur pointe vers l'équivalent de la page courante, jamais vers
// l'accueil : la bascule reste cohérente au fil de la navigation (§5).
// Drapeau britannique pour l'anglais, jamais américain.
const other: Locale = locale === 'fr' ? 'en' : 'fr';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__identity" href={urlFor('home', locale)}>
      <span class="site-header__name">{t.siteTitle}</span>
      <span class="site-header__role">{t.role}</span>
      <span class="site-header__affiliation">{t.affiliation}</span>
    </a>

    <nav class="site-nav" aria-label={locale === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul>
        {
          navOrder.map((id) => (
            <li>
              <a href={urlFor(id, locale)} aria-current={id === pageId ? 'page' : undefined}>
                {t.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      pageId && (
        <a
          class="lang-switch"
          href={urlFor(pageId, other)}
          lang={other}
          hreflang={other}
          title={t.switchTo}
          aria-label={t.switchTo}
        >
          {
            other === 'en' ? (
              <svg viewBox="0 0 60 30" role="img" aria-hidden="true">
                <clipPath id="drapeau-uk">
                  <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
                </clipPath>
                <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
                <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
                <path
                  d="M0,0 L60,30 M60,0 L0,30"
                  clip-path="url(#drapeau-uk)"
                  stroke="#c8102e"
                  stroke-width="4"
                />
                <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
                <path d="M30,0 v30 M0,15 h60" stroke="#c8102e" stroke-width="6" />
              </svg>
            ) : (
              <svg viewBox="0 0 60 30" role="img" aria-hidden="true">
                <rect width="60" height="30" fill="#fff" />
                <rect width="20" height="30" fill="#002395" />
                <rect x="40" width="20" height="30" fill="#ed2939" />
              </svg>
            )
          }
        </a>
      )
    }
  </div>
</header>
