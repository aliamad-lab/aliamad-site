---
import { profileLinks, ui, type Locale } from '../i18n/config';
import ContactLink from './ContactLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__block">
      <h2 class="site-footer__heading">{t.contactLabel}</h2>
      <p><ContactLink /></p>
      <p class="site-footer__address">
        {
          locale === 'fr'
            ? 'Service de psychiatrie adulte, CHU de Lille — Faculté de médecine, Université de Lille'
            : 'Department of Adult Psychiatry, Lille University Hospital — Faculty of Medicine, University of Lille'
        }
      </p>
    </div>

    <div class="site-footer__block">
      <h2 class="site-footer__heading">{t.profiles}</h2>
      <ul class="site-footer__links">
        {
          profileLinks.map((link) => (
            <li>
              <a href={link.href} rel="noopener">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="site-footer__legal">© {year} Ali Amad</p>
</footer>
