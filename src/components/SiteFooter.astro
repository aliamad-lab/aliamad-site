---
import { profileLinks, ui, type Locale } from '../i18n/config';
import ContactLink from './ContactLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();

const rattachements =
  locale === 'fr'
    ? ['Faculté de médecine, Université de Lille', 'Service de psychiatrie adulte, CHU de Lille']
    : ['Faculty of Medicine, University of Lille', 'Department of Adult Psychiatry, Lille University Hospital'];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__ligne">
      <strong>{t.contactLabel}</strong>
      <ContactLink />
    </p>

    <p class="site-footer__ligne">
      {rattachements.map((r) => <span>{r}</span>)}
    </p>

    <ul class="site-footer__liens">
      {
        profileLinks.map((link) => (
          <li>
            <a href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="site-footer__legal">© {year} Ali Amad</p>
  </div>
</footer>
