---
import { profileLinks, ui, type Locale } from '../i18n/config';
import ContactLink from './ContactLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

/**
 * Repris tel quel de l'ancien site : une simple ligne de liens centrée,
 * précédée d'un maillon, séparée par des barres verticales, sans fond ni
 * encadrement. L'adresse de contact s'y ajoute sur la même ligne — elle est
 * exigée par le cahier des charges §4, que l'ancien site ne respectait pas.
 */
---

<footer class="site-footer">
  <p class="site-footer__liens">
    <span aria-hidden="true">🔗</span>
    {
      profileLinks.map((link, i) => (
        <>
          {i > 0 && <span class="site-footer__barre" aria-hidden="true">|</span>}
          <a href={link.href} rel="noopener">
            {link.label}
          </a>
        </>
      ))
    }
  </p>

  <p class="site-footer__contact">
    <span aria-hidden="true">✉</span> <ContactLink />
  </p>
</footer>

<style>
  /* Disposition de l'ancien site — une ligne de liens centrée — mais posée sur
     un aplat plus soutenu et séparée par un filet : le pied doit se distinguer
     du corps de la page, ce que l'ancien ne faisait pas. */
  .site-footer {
    margin-top: 6rem;
    padding: 2.6rem var(--gutter) 2.8rem;
    text-align: center;
    background: var(--paper-sunk);
    border-top: 1px solid var(--rule);
  }

  .site-footer p {
    max-width: var(--shell);
    margin: 0 auto 0.45rem;
    font-size: 0.98rem;
  }

  .site-footer__barre {
    color: var(--rule);
    margin-inline: 0.45rem;
  }

  .site-footer__contact {
    color: var(--ink-soft);
  }
</style>
