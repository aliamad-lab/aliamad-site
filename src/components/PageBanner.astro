---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Point de focalisation CSS, ex. « 50% 30% » */
  focus?: string;
  credit?: string;
}

const { image, alt, focus = '50% 50%', credit } = Astro.props;

/**
 * L'original n'est jamais rogné : il est servi entier, et seul le point de
 * focalisation décide de ce qui reste visible dans le bandeau. Recadrer revient
 * donc à changer une valeur dans le frontmatter, et l'image reste réutilisable
 * autrement — ce que le format bannière de Google Sites interdisait.
 */
---

<figure class="banner">
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1440, 1920]}
    sizes="(min-width: 68rem) 68rem, 100vw"
    format="webp"
    style={`object-position: ${focus}`}
    loading="eager"
  />
  {credit && <figcaption class="banner__credit">{credit}</figcaption>}
</figure>

<style>
  /*
   * L'image part du même bord gauche que le titre et le texte, et s'étend
   * seule vers la droite jusqu'au bord du cadre. Elle est donc plus large que
   * la colonne de texte sans jamais la déborder à gauche : une seule verticale
   * commande toute la page.
   */
  .banner {
    /* Même intervalle au-dessus qu'en dessous : c'est cette symétrie qui donnait
       son assise au bandeau de l'ancien site. Le titre le précède, le texte le
       suit, tous deux à égale distance. */
    margin: 0 0 var(--rythme);
    width: 100%;
  }

  .banner :global(img) {
    width: 100%;
    aspect-ratio: var(--bandeau);
    height: auto;
    object-fit: cover;
    display: block;
  }

  /* Sur un écran étroit, une bande de 4,75:1 se réduirait à un filet illisible :
     on la laisse reprendre de la hauteur. */
  @media (max-width: 40rem) {
    .banner :global(img) {
      aspect-ratio: 2.6 / 1;
    }
  }

  .banner__credit {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
