---
import publications from '../data/publications.json';

const locale = Astro.currentLocale ?? 'fr';

/**
 * Les publications sont groupées par année décroissante. Le titre porte le lien
 * vers le DOI quand il existe : sans lui, le lecteur reste devant une liste de
 * titres inertes, sans moyen d'atteindre l'article.
 */
// Une référence sans titre ne peut pas être présentée au lecteur. Elle reste
// dans les données et dans le rapport de relecture, où elle attend d'être
// complétée, mais n'apparaît pas ici sous forme de ligne vide.
const affichables = publications.filter((p) => p.titre?.trim());

const parAnnee = new Map<number | string, typeof publications>();
for (const p of affichables) {
  const annee = p.annee ?? (locale === 'en' ? 'Undated' : 'Sans date');
  if (!parAnnee.has(annee)) parAnnee.set(annee, []);
  parAnnee.get(annee)!.push(p);
}

const annees = [...parAnnee.keys()].sort((a, b) => {
  if (typeof a === 'string') return 1;
  if (typeof b === 'string') return -1;
  return b - a;
});

// Le décompte figure dans le texte d'introduction de la page, pas ici : deux
// chiffres à deux endroits finiraient par diverger.
const t = locale === 'en' ? { libre: 'Open access' } : { libre: 'En accès libre' };

/**
 * Scholar livre les auteurs sous deux formes mêlées : « Amad, Ali » et
 * « Pierre A Geoffroy ». Juxtaposées telles quelles et séparées par des
 * virgules, on ne distingue plus où finit un nom et où commence le suivant.
 * On les ramène donc tous à la forme « Amad A », usuelle en biomédecine et
 * sans ambiguïté.
 */
function formaterAuteur(brut: string): string {
  const auteur = brut.trim();
  if (!auteur) return '';

  // BibTeX signale une liste tronquée par le mot-clé « others ».
  if (/^others$/i.test(auteur)) return locale === 'en' ? 'et al.' : 'et al.';

  let nom: string;
  let prenoms: string;

  if (auteur.includes(',')) {
    const [n, ...reste] = auteur.split(',');
    nom = n.trim();
    prenoms = reste.join(' ').trim();
  } else {
    const morceaux = auteur.split(/\s+/);
    nom = morceaux.pop() ?? '';
    prenoms = morceaux.join(' ');
  }

  const initiales = prenoms
    .split(/[\s.-]+/)
    .filter(Boolean)
    .map((p) => p[0].toUpperCase())
    .join('');

  return initiales ? `${nom} ${initiales}` : nom;
}

/** Met en évidence la signature d'Ali parmi ses co-auteurs. */
const estAli = (auteur: string) => /^Amad\b/i.test(formaterAuteur(auteur));
---

{
  annees.map((annee, rang) => (
    /*
     * <details> plie et déplie sans une ligne de JavaScript, reste accessible
     * au clavier et aux lecteurs d'écran, et laisse le contenu trouvable par
     * la recherche du navigateur. L'année la plus récente s'ouvre d'emblée,
     * les précédentes attendent le clic.
     */
    <details class="publications__annee" open={rang === 0}>
      <summary id={`annee-${annee}`}>
        <span class="publications__annee-titre">{annee}</span>
        <span class="publications__annee-compte">{parAnnee.get(annee)!.length}</span>
      </summary>
      <ol class="publications__liste">
        {parAnnee.get(annee)!.map((p) => (
          <li class="publication">
            <span class="publication__auteurs">
              {p.auteurs.map((a, i) => (
                <>
                  {i > 0 && ', '}
                  <span class={estAli(a) ? 'publication__moi' : undefined}>{formaterAuteur(a)}</span>
                </>
              ))}
              {/* « et al. » porte déjà son point : en ajouter un ferait double. */}
              {p.auteurs.length > 0 && (/^others$/i.test(p.auteurs.at(-1)?.trim() ?? '') ? ' ' : '. ')}
            </span>

            <span class="publication__titre">
              {p.doi ? (
                <a href={`https://doi.org/${p.doi}`} rel="noopener">
                  {p.titre}
                </a>
              ) : (
                p.titre
              )}
              .
            </span>

            {p.revue && <span class="publication__revue"> {p.revue}</span>}
            {p.volume && <span>, {p.volume}</span>}
            {p.numero && <span>({p.numero})</span>}
            {p.pages && <span>, {p.pages}</span>}
            {(p.revue || p.volume || p.pages) && '.'}

            {p.accesLibre && p.urlAccesLibre && (
              <>
                {' '}
                <a class="publication__libre" href={p.urlAccesLibre} rel="noopener">
                  {t.libre}
                </a>
              </>
            )}
          </li>
        ))}
      </ol>
    </details>
  ))
}

<style>
  .publications__compte {
    color: var(--ink-soft);
    font-size: 0.92rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }

  .publications__annee summary {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    cursor: pointer;
    list-style: none;
    margin-block: 1.4em 0.6em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--rule);
  }

  /* Le triangle par défaut de Safari, remplacé par le chevron ci-dessous. */
  .publications__annee summary::-webkit-details-marker {
    display: none;
  }

  .publications__annee summary::before {
    content: '';
    width: 0.42em;
    height: 0.42em;
    border-right: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--accent);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    flex: none;
    align-self: center;
  }

  .publications__annee[open] summary::before {
    transform: rotate(45deg);
  }

  .publications__annee-titre {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent-deep);
  }

  .publications__annee-compte {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .publications__annee summary:hover .publications__annee-titre {
    color: var(--accent);
  }

  .publications__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: publication;
  }

  .publication {
    /* Le texte justifié convient au discours suivi, pas à des références où
       les blancs se creuseraient entre noms propres et numéros de volume. */
    text-align: left;
    hyphens: manual;
    font-size: 0.98rem;
    line-height: 1.55;
    margin-block: 0 1em;
    padding-left: 1.4rem;
    text-indent: -1.4rem;
  }

  .publication__moi {
    font-weight: 600;
    color: var(--ink);
  }

  .publication__auteurs,
  .publication__revue {
    color: var(--ink-soft);
  }

  .publication__revue {
    font-style: italic;
  }

  .publication__libre {
    font-size: 0.85em;
    white-space: nowrap;
  }
</style>
