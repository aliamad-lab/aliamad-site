---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import { routes } from '../../i18n/config';

export async function getStaticPaths() {
  const entries = await getCollection('pages', (entry) => entry.data.locale === 'en');

  return entries.map((entry) => ({
    params: { slug: routes[entry.data.pageId].en || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { pageId, title, heading, description, banner, bannerAlt, bannerFocus, bannerCredit } = entry.data;
---

<Base locale="en" pageId={pageId} title={title} description={description}>
  {banner && bannerAlt && (
    <PageBanner image={banner} alt={bannerAlt} focus={bannerFocus} credit={bannerCredit} />
  )}
  <h1>{heading}</h1>
  <div class="prose">
    <Content />
  </div>
</Base>
