---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/600.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/700.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';

/**
 * Page de travail, temporaire : elle sert à trancher les décisions laissées
 * ouvertes au §10 du cahier des charges (couleurs exactes, choix des polices).
 * Elle disparaîtra une fois la charte arrêtée. Hors menu et non indexable.
 */
const variants = [
  {
    id: 'a',
    nom: 'A — Garamond',
    type: 'EB Garamond, titres et texte',
    argument:
      "Claude Garamond était graveur à Paris au XVIe siècle : la police porte une filiation française et savante. Une seule famille pour tout le site, ce qui donne une page très unie, proche du livre imprimé.",
    accent: '#003153',
    papier: '#FBF9F3',
  },
  {
    id: 'b',
    nom: 'B — Spectral',
    type: 'Spectral, titres et texte',
    argument:
      "Dessinée pour la lecture à l'écran, plus contemporaine et un peu plus dense. Le gris de page reste régulier sur les longs paragraphes de description de recherche.",
    accent: '#16324F',
    papier: '#F8F6F1',
  },
  {
    id: 'c',
    nom: 'C — Baskerville et Source Serif',
    type: 'Libre Baskerville pour les titres, Source Serif pour le texte',
    argument:
      "Deux familles, donc un contraste marqué entre le titre, affirmé et anglais de tradition, et un texte courant très lisible. La hiérarchie se lit de plus loin.",
    accent: '#0B3C5D',
    papier: '#FAF7F0',
  },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Essais de charte — travail en cours</title>
  </head>

  <body>
    <header class="intro">
      <h1>Essais de charte graphique</h1>
      <p>
        Trois propositions complètes, sur un extrait réel du site. Chacune fixe une famille
        typographique, une teinte de papier et une déclinaison de bleu. Comparez d'abord l'allure
        générale, puis le confort de lecture du paragraphe long.
      </p>
      <p class="intro__note">
        Page de travail, invisible pour les moteurs de recherche. Elle disparaîtra une fois le choix
        arrêté.
      </p>
    </header>

    {
      variants.map((v) => (
        <section class="essai" data-variant={v.id}>
          <div class="essai__etiquette">
            <h2>{v.nom}</h2>
            <p class="essai__type">{v.type}</p>
            <p class="essai__argument">{v.argument}</p>
            <p class="essai__valeurs">
              <span class="pastille" style={`background:${v.accent}`} /> {v.accent}
              <span class="pastille pastille--bord" style={`background:${v.papier}`} /> {v.papier}
            </p>
          </div>

          <div class="essai__rendu">
            <div class="demo">
              <div class="demo__entete">
                <div>
                  <span class="demo__nom">Ali Amad</span>
                  <span class="demo__fonction">
                    Professeur de psychiatrie — Université de Lille, CHU de Lille
                  </span>
                </div>
                <nav class="demo__nav">
                  <span>Accueil</span>
                  <span class="est-actif">Recherche</span>
                  <span>Publications</span>
                </nav>
              </div>

              <h3 class="demo__h1">Activités de recherche</h3>

              <p>
                Mon activité de recherche s'inscrit à l'interface entre clinique psychiatrique
                spécialisée et neurosciences cliniques. Elle vise à mieux caractériser les troubles
                psychiatriques sévères, résistants et cliniquement complexes, en développant des
                approches permettant d'objectiver la symptomatologie, d'analyser les trajectoires
                cliniques et d'améliorer la prédiction de la réponse aux traitements.
              </p>

              <h4 class="demo__h3">Clinique psychiatrique objective — CALYPSO</h4>

              <p>
                Le projet CALYPSO est issu de travaux et de réflexions relatifs au concept de
                « clinique fondamentale », c'est-à-dire l'étude des fondements de l'étude des
                manifestations cliniques. En s'intéressant aux définitions et aux origines des signes
                et symptômes en psychiatrie, on s'aperçoit rapidement que le modèle clinique
                psychiatrique s'est développé, au moins en France, sur le modèle de la sémiologie
                médicale dans le contexte de la méthode anatomo-clinique.
              </p>

              <p>
                Une part importante de mes travaux est consacrée à l'étude de la
                <a href="#">catatonie</a>, envisagée comme un syndrome psychomoteur transdiagnostique.
              </p>

              <p class="demo__pied">
                Faculté de médecine, Université de Lille — Service de psychiatrie adulte, CHU de Lille
              </p>
            </div>
          </div>
        </section>
      ))
    }
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #eceae5;
    font-family: system-ui, sans-serif;
    color: #26241f;
  }

  .intro {
    max-width: 42rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 1rem;
  }

  .intro h1 {
    font-size: 1.6rem;
    margin: 0 0 0.6rem;
  }

  .intro p {
    line-height: 1.6;
    margin: 0 0 0.8rem;
  }

  .intro__note {
    font-size: 0.85rem;
    color: #6a665e;
  }

  .essai {
    max-width: 72rem;
    margin: 2.5rem auto;
    padding-inline: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .essai__etiquette h2 {
    font-size: 1.15rem;
    margin: 0 0 0.3rem;
  }

  .essai__type {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    color: #6a665e;
  }

  .essai__argument {
    margin: 0 0 0.8rem;
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 30rem;
  }

  .essai__valeurs {
    margin: 0;
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
    color: #6a665e;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .pastille {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    display: inline-block;
  }

  .pastille--bord {
    border: 1px solid #c9c4b8;
    margin-left: 0.6rem;
  }

  /* ---- Le rendu proprement dit ---- */

  .demo {
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--v-papier);
    color: var(--v-encre);
    font-family: var(--v-texte);
    font-size: 1.08rem;
    line-height: 1.66;
  }

  .demo__entete {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--v-filet);
    margin-bottom: 2rem;
  }

  .demo__nom {
    display: block;
    font-family: var(--v-titre);
    font-size: 1.5rem;
    font-weight: var(--v-titre-graisse);
    color: var(--v-accent);
    line-height: 1.15;
  }

  .demo__fonction {
    display: block;
    font-size: 0.85rem;
    color: var(--v-encre-douce);
  }

  .demo__nav {
    display: flex;
    gap: 1.3rem;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--v-encre-douce);
  }

  .demo__nav .est-actif {
    color: var(--v-accent);
    border-bottom: 2px solid var(--v-accent);
    padding-bottom: 0.15rem;
  }

  .demo__h1 {
    font-family: var(--v-titre);
    font-weight: var(--v-titre-graisse);
    color: var(--v-accent);
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
    line-height: 1.18;
    margin: 0 0 0.7em;
  }

  .demo__h3 {
    font-family: var(--v-titre);
    font-weight: var(--v-titre-graisse);
    color: var(--v-accent);
    font-size: 1.3rem;
    line-height: 1.25;
    margin: 2em 0 0.4em;
  }

  .demo p {
    margin: 0 0 1.1em;
    max-width: 34rem;
  }

  .demo a {
    color: var(--v-accent);
    text-underline-offset: 0.18em;
  }

  .demo__pied {
    margin-top: 2.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--v-filet);
    font-size: 0.88rem;
    color: var(--v-encre-douce);
  }

  /* ---- Variantes ---- */

  [data-variant='a'] .demo {
    --v-papier: #fbf9f3;
    --v-encre: #1f1d1a;
    --v-encre-douce: #55514a;
    --v-filet: #e0d9c9;
    --v-accent: #003153;
    --v-titre: 'EB Garamond', Georgia, serif;
    --v-texte: 'EB Garamond', Georgia, serif;
    --v-titre-graisse: 600;
    font-size: 1.18rem;
  }

  [data-variant='b'] .demo {
    --v-papier: #f8f6f1;
    --v-encre: #1a1c1e;
    --v-encre-douce: #4f5459;
    --v-filet: #dcd8ce;
    --v-accent: #16324f;
    --v-titre: 'Spectral', Georgia, serif;
    --v-texte: 'Spectral', Georgia, serif;
    --v-titre-graisse: 600;
    font-size: 1.02rem;
  }

  [data-variant='c'] .demo {
    --v-papier: #faf7f0;
    --v-encre: #22201c;
    --v-encre-douce: #57534b;
    --v-filet: #e3dccb;
    --v-accent: #0b3c5d;
    --v-titre: 'Libre Baskerville', Georgia, serif;
    --v-texte: 'Source Serif 4', Georgia, serif;
    --v-titre-graisse: 700;
    font-size: 1.05rem;
  }

  @media (min-width: 62rem) {
    .essai {
      grid-template-columns: 17rem 1fr;
      gap: 2.5rem;
    }
  }
</style>
